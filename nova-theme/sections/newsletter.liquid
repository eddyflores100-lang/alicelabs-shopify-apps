<section class="section newsletter">
  <div class="page-width">
    <h2 class="newsletter__title">{{ section.settings.heading }}</h2>
    <p class="newsletter__text">{{ section.settings.text }}</p>
    {%- form 'customer' -%}
      <div class="newsletter__form">
        <input type="email" name="contact[email]" placeholder="Enter your email" required class="newsletter__input">
        <button type="submit" class="btn btn--primary">{{ section.settings.button_text }}</button>
      </div>
    {%- endform -%}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Stay in Touch" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Subscribe for exclusive offers, new arrivals, and style inspiration." },
    { "type": "text", "id": "button_text", "label": "Button text", "default": "Subscribe" }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}
