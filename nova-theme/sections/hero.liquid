<section class="hero">
  <div class="hero__image">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1920 }}" alt="" loading="eager" width="1920" height="800">
    {%- else -%}
      <div style="width:100%;height:100%;background:linear-gradient(to bottom,#e8e8e8,#d0d0d0);"></div>
    {%- endif -%}
  </div>

  <div class="hero__content {{ section.settings.text_color }}">
    {%- if section.settings.heading != blank -%}
      <h1 class="hero__title">{{ section.settings.heading }}</h1>
    {%- endif -%}
    {%- if section.settings.subheading != blank -%}
      <p class="hero__subtitle">{{ section.settings.subheading }}</p>
    {%- endif -%}
    <div class="hero__cta">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button2_label != blank -%}
        <a href="{{ section.settings.button2_link }}" class="btn btn--secondary" style="border-color:currentColor;">{{ section.settings.button2_label }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "select", "id": "text_color", "label": "Text color", "options": [{"value":"hero__content--light","label":"Light (for dark images)"},{"value":"hero__content--dark","label":"Dark (for light images)"}],"default":"hero__content--light"},
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Shop our latest collection." },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Shop Now" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "text", "id": "button2_label", "label": "Second button text" },
    { "type": "url", "id": "button2_link", "label": "Second button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
