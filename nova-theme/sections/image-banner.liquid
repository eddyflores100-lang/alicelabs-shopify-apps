<section class="image-banner">
  <div class="image-banner__image">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 1920 }}" alt="" loading="lazy" width="1920" height="800">
    {%- else -%}
      <div style="width:100%;height:100%;background:#1a1a1a;"></div>
    {%- endif -%}
  </div>
  <div class="image-banner__content">
    {%- if section.settings.heading != blank -%}
      <h2 class="image-banner__title">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="image-banner__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank -%}
      <a href="{{ section.settings.button_link }}" class="btn btn--primary">{{ section.settings.button_label }}</a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Image Banner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Summer Collection" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Discover pieces designed for the season." },
    { "type": "text", "id": "button_label", "label": "Button text", "default": "Shop Collection" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Image Banner" }]
}
{% endschema %}
