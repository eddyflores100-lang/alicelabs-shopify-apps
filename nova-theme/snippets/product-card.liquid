<div class="product-card">
  <div class="product-card__media">
    <a href="{{ product.url }}">
      {%- if product.featured_image -%}
        <img src="{{ product.featured_image | image_url: width: 600 }}" alt="{{ product.title | escape }}" loading="lazy" width="600" height="800">
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </a>

    {%- if product.compare_at_price > product.price and product.available -%}
      <span class="product-card__badge product-card__badge--sale">Sale</span>
    {%- elsif product.available == false -%}
      <span class="product-card__badge product-card__badge--soldout">Sold Out</span>
    {%- endif -%}
  </div>

  {%- if product.vendor != blank -%}
    <p class="product-card__vendor">{{ product.vendor }}</p>
  {%- endif -%}

  <h3 class="product-card__title">
    <a href="{{ product.url }}">{{ product.title | truncate: 50 }}</a>
  </h3>

  <div class="product-card__price">
    {%- if product.compare_at_price > product.price -%}
      <span class="product-card__price--sale">{{ product.price | money }}</span>
      <span class="product-card__compare-price">{{ product.compare_at_price | money }}</span>
    {%- else -%}
      <span>{{ product.price | money }}</span>
    {%- endif -%}
  </div>
</div>
